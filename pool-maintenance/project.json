{
  "name": "pool-maintenance",
  "tags": ["type:e2e", "lang:bash"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync shellcheck pool-maintenance/measure.sh pool-maintenance/pool-maintenance-test.sh"
      }
    },
    // Uncached: it plans nx task graphs over every project and reads the root
    // justfile, onevcs.toml and .cargo/config.toml, which no input here can key.
    "test-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash pool-maintenance/pool-maintenance-test.sh"
      }
    },
    "budgets-host": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec onebudgetspec check pool-maintenance/budgets.yaml --label host"
      }
    }
  }
}
