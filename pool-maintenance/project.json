{
  "name": "pool-maintenance",
  "tags": ["type:e2e", "lang:bash"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync shellcheck pool-maintenance/measure.sh"
      }
    },
    // The host tier: builds the workspace twice and prunes this checkout's real
    // target dir. Only the `budgets` recipe selects it; the declaration's offline
    // test lives in its own project (`declaration/`) so no script edit pays for it.
    "budgets-host": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec onebudgetspec check pool-maintenance/budgets.yaml --label host"
      }
    }
  }
}
