{
  "name": "pool-maintenance-declaration",
  "tags": ["type:e2e", "lang:bash"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync shellcheck pool-maintenance/declaration/pool-maintenance-test.sh"
      }
    },
    // Offline: the pruner and cargo are recording stubs, so nothing is built,
    // pruned or installed. Uncached: it plans nx task graphs over every project
    // and reads the root justfile, onevcs.toml and .cargo/config.toml, which no
    // input here can key.
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash pool-maintenance/declaration/pool-maintenance-test.sh"
      }
    }
  }
}
