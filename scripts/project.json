{
  "name": "release-packaging",
  "implicitDependencies": ["github-workflows"],
  "tags": ["type:e2e", "lang:bash"],
  "namedInputs": {
    "default": [
      "{projectRoot}/stage-release-product.sh",
      "{projectRoot}/stage-and-verify-release-product.py",
      "{projectRoot}/release-product-test.sh",
      "{projectRoot}/check-release-identity.sh",
      "{projectRoot}/smoke-*-bundle.sh",
      "{projectRoot}/verify-release-archive*",
      "{projectRoot}/verify-staged-archives.sh",
      "{projectRoot}/release-checksums.txt",
      // llmlint: ignore[shell_test_tiers_stay_split] This project is release-packaging, itself the type:e2e host-tool tier (its release journey already drives real Git); ensure-github-release-test.sh runs from `just release-targets-check`, and listing it here only keys the lint cache to it.
      "{projectRoot}/ensure-github-release*",
      "{projectRoot}/await-registry-install*",
      "{projectRoot}/install.sh",
      "{projectRoot}/install-test.sh",
      "{workspaceRoot}/release-platforms.toml",
      "{workspaceRoot}/.github/tests/release-journey.mjs"
    ]
  },
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync shellcheck scripts/stage-release-product.sh scripts/release-product-test.sh scripts/check-release-identity.sh scripts/smoke-python-bundle.sh scripts/smoke-npm-bundle.sh scripts/verify-release-archive.sh scripts/verify-release-archive-test.sh scripts/verify-staged-archives.sh scripts/install-test.sh scripts/ensure-github-release.sh scripts/ensure-github-release-test.sh scripts/await-registry-install.sh scripts/await-registry-install-test.sh && uv run --no-sync ruff check scripts/stage-and-verify-release-product.py"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync ty check scripts/stage-and-verify-release-product.py"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --no-sync ruff format --check scripts/stage-and-verify-release-product.py && node .github/project-format.mjs --scripts"
      }
    },
    // llmlint: ignore[new_projects_keep_the_graph_uniform] The production builder journey belongs to the explicit release-product-test edge; selecting it with the ordinary test-e2e fan-out would add a slow unrelated rebuild to every workflow change.
    "packaging": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "bash scripts/release-product-test.sh"
      }
    }
  }
}
